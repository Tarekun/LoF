# inductive definition for naturals
inductive Nat: TYPE {
  | z: Nat
  | s: Nat -> Nat
}

# i want to test parsing and type checking, not execution
# wrapping the match in a function prevents it from failing on execution
fun test_function (n:Nat) : Nat {
    match n with
    | z => z,             # 0->0
    | s(z) => z,          # 1->0
    | s(s(z)) => z,       # 2->0
    | s(nn) => s(z),      # else->1
}


# inductive definition for lists of naturals
inductive List : TYPE {
  | nil: List
  | cons: Nat -> List -> List
}

fun test_function2 (l:List): Nat {
    match l with
    | nil => z,
    | cons(n, nil) => s(z),
    | cons(n, cons(m, nil)) => s(s(z)),
    | cons(n, cons(m, cons(o, nil))) => s(s(s(z))),
    | cons(n, l) => z,
}
