{
  "name": "LoF Theorem Prover",
  "scopeName": "source.lof",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#operators" },
    { "include": "#comments" },
    { "include": "#variables" },
    { "include": "#types" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lof",
          "match": "\\b(axiom|begin|exact|fun|global|if|import|inductive|lambda|lemma|let|match|proposition|qed|sugar|intro|rec|theorem|with)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lof",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.lof",
          "match": "#.*$"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.lof",
          "match": "\\b[\\p{Ll}][\\p{Ll}\\p{Nd}_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.pascal.lof",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
        },
        {
          "name": "support.type.upper.lof",
          "match": "\\b[A-Z0-9_]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lof",
          "match": "(=>|->|\\||\\?|!|\\\\)"
        }
      ]
    }
  }
}
