# CIC definition of =
inductive Eq (T:TYPE) (x:T) : T -> PROP {
  | refl: Eq T x x
}

# CIC definition for naturals
inductive Nat: TYPE {
  | z: Nat 
  | s: Nat -> Nat
}

# natural addition
fun rec plus (n:Nat) (m:Nat) : Nat {
  match n with 
  | z => m,
  | s nn => s (plus nn m),
}

# TODO: this needs CIC unification to start by computing normal forms and then checking term SO unification
# theorem zero_plus_one_term : Eq Nat (plus z (s z)) (s z) := (refl Nat (s z))

theorem zero_plus_one_tac : Eq Nat (plus z (s z)) (s z) := 
  begin
  exact refl Nat (s z)
  qed.
