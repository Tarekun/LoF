# Regression test for the interactive tactic proof system (`intro`, `exact`,
# `apply`). Before the fixes this file exercises:
#
# 1. `intro` never added the introduced assumption to the type checking
#    environment, so any later step referencing it failed with
#    "Unbound variable: <name>".
# 2. even once that was fixed, the codomain handed back as the next subgoal
#    still carried the enclosing `forall`'s own (non-global) de Bruijn index
#    for the introduced variable, which never structurally unified with a
#    later, independently-elaborated reference to the same variable by name.
# 3. `swap_body` (used to grow the partial proof term step by step)
#    rebuilt an `Abstraction` proof term as a `Product` (a *type* former),
#    which made the final constructed proof fail to type check as soon as
#    a proof used more than one tactic step (even a single `intro` followed
#    by `exact`).

inductive Nat: TYPE {
  | z: Nat
  | s: Nat -> Nat
}

inductive Eq (T:TYPE, x:T) : T -> PROP {
  | refl: Eq(T, x, x)
}

# a single `intro` followed by `exact` referencing the introduced variable
theorem single_intro : ∀n:Nat. Eq(Nat, n, n) :=
  begin
  intro n : Nat
  exact refl(Nat, n)
  qed.

# two nested `intro`s before closing the proof
theorem double_intro : ∀n:Nat. ∀m:Nat. Eq(Nat, n, n) :=
  begin
  intro n : Nat
  intro m : Nat
  exact refl(Nat, n)
  qed.

axiom P : PROP;
axiom Q : PROP;
axiom pq : P -> Q;
axiom p : P;

# `apply` followed by a further tactic step to discharge its premise
theorem apply_then_exact : Q :=
  begin
  apply pq
  exact p
  qed.
