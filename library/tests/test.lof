# introduce a symbol for the naturals type
axiom Nat : TYPE;

# introduce symbols for zero and successor function
axiom z : Nat;
axiom s : Nat -> Nat;

# introduce symbols for equality and plus function
axiom NatEq : Nat -> Nat -> PROP;
axiom plus : Nat -> Nat -> Nat;

# for all naturals n. 0+n = n
axiom ax1 : \forall n : Nat. NatEq (plus z n) n;
# for all naturals n,m,p. n+m = p => s(n)+m = s(p)
axiom ax2 : \forall n:Nat. \forall m:Nat. \forall p:Nat. NatEq (plus n m) p -> NatEq (plus (s n) m) (s p);

# solve the equation 1+r = 3
solve NatEq (plus (s z) r) (s (s (s z)))
# should pass
solve NatEq (plus (s z) (s (s z))) (s (s (s z)))
# should fail but passes
solve NatEq (plus (s z) (s z)) (s (s (s z)))
solve NatEq (plus (s z) (s (s (s z)))) (s (s (s z)))
# should fail and actually fails
#solve NatEq (plus (s z) z) (s (s (s z)))
