# EXPECTED-FAILURE fixture. Deliberately lives outside
# `library/tests/proofs/` so `test_dedicated_scripts` (which asserts every
# file it finds succeeds) doesn't pick it up; it is asserted to FAIL by
# `test_transport_expected_failures` in runtime/entrypoints.rs.
#
# This pins down the sharpest limitation of the transport MVP, described in
# full in docs/language/systems/transport.md:
#
#   Transporting a *definition* whose dep_elim is a DERIVED theorem (rather
#   than an inductive type's own auto-generated eliminator) produces a
#   well-typed but NON-COMPUTING definition, so any theorem whose proof
#   relies on that definition reducing - even just a base case discharged
#   by `refl` - cannot be transported on top of it.
#
# Concretely: `plus_z_r`'s base case is `refl(Nat, z)`, which type checks
# only because `plus(z,z)` ι-reduces to `z` (`plus` is `match`-based, so it
# computes). The transported statement needs `plus_bin(bz,bz)` to reduce to
# `bz` - but `plus_bin` is built from `bin_succ_induction`, a theorem, and
# theorems are opaque to reduction in this kernel exactly like axioms. So
# the base case has no proof and unification fails on
# `bin_succ_induction(..., bz)` vs `bz`.
#
# Note this is NOT fixed by the eliminator ι-reduction rule
# (`try_reduce_eliminator_application`): that rule fires for an inductive's
# own `e_<Type>`, and `Bin`'s own `e_Bin` cannot serve as dep_elim here,
# because its `bp` case takes a `Pos` rather than a recursive `Bin` - which
# is precisely why `bin_succ_induction` has to be derived in the first
# place.

!theory_block cic
inductive Nat: TYPE {
  | z: Nat
  | s: Nat -> Nat
}
inductive Pos: TYPE {
  | xH: Pos
  | xO: Pos -> Pos
  | xI: Pos -> Pos
}
inductive Bin: TYPE {
  | bz: Bin
  | bp: Pos -> Bin
}
inductive Eq (T:TYPE, x:T) : T -> PROP {
  | refl: Eq(T, x, x)
}
!end_block

fun rec plus (n:Nat, m:Nat) : Nat {
  match n with
  | z => m,
  | s(nn) => s(plus(nn, m)),
}

fun rec pos_succ (p: Pos) : Pos {
  match p with
  | xH => xO(xH),
  | xO(pp) => xI(pp),
  | xI(pp) => xO(pos_succ(pp)),
}

fun bin_succ (b: Bin) : Bin {
  match b with
  | bz => bp(xH),
  | bp(p) => bp(pos_succ(p)),
}

fun rec nat_to_bin (n: Nat) : Bin {
  match n with
  | z => bz,
  | s(nn) => bin_succ(nat_to_bin(nn)),
}

fun rec pos_to_nat (p: Pos) : Nat {
  match p with
  | xH => s(z),
  | xO(pp) => plus(pos_to_nat(pp), pos_to_nat(pp)),
  | xI(pp) => s(plus(pos_to_nat(pp), pos_to_nat(pp))),
}

fun bin_to_nat (b: Bin) : Nat {
  match b with
  | bz => z,
  | bp(p) => pos_to_nat(p),
}

# the pieces below are assumed rather than re-derived: this fixture exists
# to pin the transport failure, not to redo the arithmetic of
# library/tests/proofs/transport_nat_bin.lof
axiom section_nat_bin : ∀n:Nat. Eq(Nat, bin_to_nat(nat_to_bin(n)), n);
axiom retraction_nat_bin : ∀b:Bin. Eq(Bin, nat_to_bin(bin_to_nat(b)), b);
axiom bin_succ_correct : ∀b:Bin. Eq(Nat, bin_to_nat(bin_succ(b)), s(bin_to_nat(b)));
axiom bin_succ_induction :
  ∀C:(Bin -> TYPE).
    C(bz) ->
    (∀b:Bin. C(b) -> C(bin_succ(b))) ->
    ∀b:Bin. C(b);

theorem plus_z_r : ∀n:Nat. Eq(Nat, plus(n,z), n) :=
  (e_Nat(
    (\lambda n:Nat. Eq(Nat, plus(n,z), n)),
    refl(Nat, z),
    (\lambda r:Nat. \lambda ih: Eq(Nat, plus(r,z), r).
      e_Eq(Nat, plus(r,z),
           (\lambda y:Nat. \lambda h: Eq(Nat, plus(r,z), y). Eq(Nat, s(plus(r,z)), s(y))),
           refl(Nat, s(plus(r,z))),
           r,
           ih))
  ))

equivalence NatBin : Nat <-> Bin {
  forward    := nat_to_bin;
  backward   := bin_to_nat;
  section    := section_nat_bin;
  retraction := retraction_nat_bin;
  dep_elim   := bin_succ_induction;
  dep_constr {
    | z => bz
    | s => bin_succ
  }
  iota {
    | z => refl(Bin, bz)
    | s => bin_succ_correct
  }
}

transport plus_bin : Bin -> Bin -> Bin from plus using NatBin;

# THIS is the statement expected to fail: the base case would need
# plus_bin(bz,bz) to reduce to bz, and it cannot.
transport plus_bin_z_r : ∀b:Bin. Eq(Bin, plus_bin(b, bz), b) from plus_z_r using NatBin;
